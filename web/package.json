{
  "name": "framecritic-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FrameCritic — 브라우저 안에서 사진을 읽고 비평을 쓰는 웹 앱",
  "scripts": {
    "assets": "node scripts/prepare-assets.cjs",
    "predev": "node scripts/prepare-assets.cjs",
    "prebuild": "node scripts/prepare-assets.cjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "check": "node scripts/contract-check.cjs"
  },
  "dependencies": {
    "@litertjs/core": "^2.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
